# Discord (required)
LIVE_DISCORD_TOKEN=
BETA_DISCORD_TOKEN=
WGGBOT_DEBUG=false

# Runtime
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
SYNC_COMMANDS=true
LOG_LEVEL=INFO
WGGBOT_DATA_DIR=/app/data

# Modules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
COMFYUI_URL=http://127.0.0.1:8188

# Music
YTDLP_COOKIE_FILE=/app/cookies.txt
MUSIC_MAX_QUEUE=100
MUSIC_MAX_PLAYLIST=50
MUSIC_IDLE_TIMEOUT=300
MUSIC_DEFAULT_VOLUME=50

# Optional Spotify metadata resolution
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
